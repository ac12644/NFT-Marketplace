    "forge-std": "github:foundry-rs/forge-std#v1.11.0",
    "hardhat": "3.17.0",
    "typescript": "5.9.3",
    "viem": "2.56.8"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  }
