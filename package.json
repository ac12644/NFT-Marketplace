{
  "name": "nft-marketplace",
  "version": "2.0.0",
  "private": true,
  "author": "abhishek chauhan",
  "license": "MIT",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web exec tsc --noEmit",
    "compile": "pnpm --filter contracts build && pnpm run abi",
    "test": "pnpm --filter contracts test",
    "deploy:amoy": "pnpm --filter contracts deploy:amoy",
    "abi": "pnpm --filter web run abi",
    "node": "pnpm --filter contracts node",
    "seed": "pnpm --filter contracts seed",
    "art": "pnpm --filter contracts art"
  }
}
