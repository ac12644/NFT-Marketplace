# Addresses from `pnpm deploy:amoy`, and the block they landed in (the floor
# for event queries — leaving it at 0 still works but scans the whole chain).
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=

# Amoy RPC. The public endpoint rate-limits event queries; use Alchemy/dRPC.
NEXT_PUBLIC_RPC_URL=

# Optional: enables the WalletConnect QR connector. https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: gateway used to render ipfs:// media. Defaults to ipfs.io.
NEXT_PUBLIC_IPFS_GATEWAY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_. https://app.pinata.cloud
PINATA_JWT=
PINATA_GATEWAY=
